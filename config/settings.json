{
    "store_root": "./.store",
    "db_path": "data/cairn.db",
    "overlay": {
        "edge": "right",
        "size_ratio": 0.4,
        "width": 24,
        "idle_alpha": 40,
        "hover_alpha": 180,
        "color": [100, 180, 255],
        "border_radius": 6
    },
    "parse_timeout": 30,
    "log_level": "INFO",
    "log_file": "logs/cairn.log",
    "notify": {
        "batch_window_ms": 2000,
        "silent_threshold": 5,
        "info_duration_ms": 3000,
        "error_duration_ms": 4000
    },
    "dispatcher": {
        "worker_threads": 8,
        "parse_threads": 4,
        "max_retry": 3,
        "retry_delay": 0.5
    },
    "db": {
        "busy_timeout": 30,
        "journal_mode": "WAL",
        "foreign_keys": true
    },
    "folder": {
        "auto_close_s": 5,
        "default_action": "expand"
    },
    "plugins": {
        "dir": "plugins",
        "disabled": []
    },
    "hotkey": "control+shift+space",
    "dev_mode": true
}